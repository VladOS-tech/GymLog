APP_ENV=dev

# Doctrine connections part

DB_PSQL_CONNECTION_MASTER_HOST=postgres
DB_PSQL_CONNECTION_MASTER_PORT=5432
DB_PSQL_CONNECTION_MASTER_USER=gymlog
DB_PSQL_CONNECTION_MASTER_PASSWORD=gymlog
DB_PSQL_CONNECTION_MASTER_DBNAME=gymlog
DB_PSQL_CONNECTION_MASTER_CHARSET=utf8

# Спека требует хранить время в UTC. Фиксируем таймзону сессии, чтобы она не зависела
# от настроек сервера: libpq передаёт эти опции при подключении.
PGOPTIONS=-c timezone=UTC

# Doctrine connections part end