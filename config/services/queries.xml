<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true"/>

        <!-- Сторона чтения ходит в БД мимо ORM, поэтому ей нужен Connection, а не EntityManager. -->
        <service id="GymLog\PortAdapters\Secondary\Queries\Dbal\DbalLastExerciseResultSearchService">
            <argument type="service" id="doctrine.orm.connection"/>
        </service>

        <service id="GymLog\Application\Queries\LastResult\LastExerciseResultSearchService"
                 alias="GymLog\PortAdapters\Secondary\Queries\Dbal\DbalLastExerciseResultSearchService"/>
    </services>
</container>
