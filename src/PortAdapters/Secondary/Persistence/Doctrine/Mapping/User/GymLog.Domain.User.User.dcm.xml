<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="GymLog\Domain\User\User" table="users">

        <unique-constraints>
            <unique-constraint name="users_email_uniq_index" columns="email"/>
        </unique-constraints>

        <id name="id" type="string" length="64" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="email" type="string" length="255" column="email" nullable="false"/>
        <field name="passwordHash" type="string" length="255" column="password_hash" nullable="false"/>
        <field name="createdAt" type="datetimetz_immutable" column="created_at" nullable="false"/>

    </entity>

</doctrine-mapping>